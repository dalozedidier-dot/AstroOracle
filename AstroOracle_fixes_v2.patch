         return {"n": 0}
+
+    if duckdb is None:
+        return _log_stats_fallback(cfg)
+
     con = duckdb.connect(database=":memory:")
     con.execute("CREATE TABLE logs AS SELECT * FROM read_json_auto(?)", [str(cfg.log_path)])
     n = int(con.execute("SELECT COUNT(*) FROM logs").fetchone()[0])
